#!/bin/bash

# Salir inmediatamente si ocurre algún error durante la instalación
set -e

echo "=== [1/4] Actualizando sistema e instalando dependencias de software ==="
# Software base del vídeo (Blur, Material You y efectos de fondo)
yay -S --noconfirm kvantum \
                    kwin-effects-better-blur-dx-git \
                    kde-material-you-colors-git \
                    plasma6-applets-wallpaper-effects

echo "=== [2/4] Descargando e instalando los TEMAS DEL VÍDEO (Fluent y Klassy) ==="
# Instalamos la suite Klassy (Bordes redondos y botones estilo Windows 11 o Mac)
# E instalamos el pack completo de temas e iconos Fluent recomendados en el vídeo
yay -S --noconfirm klassy-bin \
                    plasma6-themes-fluent-git \
                    fluent-icon-theme-git

echo "=== [3/4] Automatizando las Reglas de Ventana (Opacidad al 85%) ==="
mkdir -p ~/.config/kwinrulesrc.d/
cat << 'EOF' > ~/.config/kwinrulesrc
Description=Efecto Transparencia del Video
opacityactive=100
opacityactiverule=2
opacityinactive=85
opacityinactiverule=2
types=1
wmclass=not important
wmclasscomplete=false
wmclassmatch=0
EOF

echo "=== [4/4] Activando el servicio de colores dinámicos ==="
systemctl --user enable --now kde-material-you-colors.service || true

echo "=========================================================================="
echo "           ¡INSTALACIÓN DE SOFTWARE Y TEMAS COMPLETA!"
echo "=========================================================================="
echo "Para aplicar los componentes internos, REINICIA LA SESIÓN ahora mismo."
echo ""
echo "Al volver, activa los temas en tu panel de control con estos 3 pasos:"
echo "1. Estilo de Ventanas: Ve a 'Decoraciones de ventana' y elige KLASSY."
echo "2. Iconos y Colores: Ve a 'Temas Globales' o 'Iconos' y aplica FLUENT."
echo "3. Renderizado: Ve a 'Estilo de aplicaciones', cambia a KVANTUM y listo."
echo "=========================================================================="
